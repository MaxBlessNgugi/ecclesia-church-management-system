# =============================================================================
# Docker Build Context Exclusions
# =============================================================================
# Keeps the build context small and prevents leaking secrets/local state.
# =============================================================================

# Dependencies — installed fresh in the container
node_modules/
backend/node_modules/

# Build outputs — compiled in the build stage
dist/
backend/dist/

# Version control
.git/
.gitignore
.github/

# IDE / editor state
.vscode/
.idea/
*.swp
*.swo

# Documentation — not needed in the image
*.md
!README.md
docs/
tutorial-screenshots/

# Test infrastructure
e2e/
playwright-report/
test-results/

# Environment files — secrets come from docker-compose env, not baked in
.env
backend/.env

# OS metadata
.DS_Store
Thumbs.db

# Docker files themselves
Dockerfile
docker-compose*.yml
.dockerignore

# Freebuff workspace
.freebuff/
