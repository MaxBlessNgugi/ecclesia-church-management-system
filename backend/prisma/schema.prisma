// =============================================================================
// Ecclesia CMS — Prisma Database Schema
// =============================================================================
//
// DATABASE: PostgreSQL (env: DATABASE_URL)
// ORM:      Prisma Client (generate: `npx prisma generate`)
// MIGRATIONS: `npx prisma migrate dev` (dev) / `prisma migrate deploy` (prod)
// SEED:     `npx prisma db seed` → backend/prisma/seed.ts
//
// ARCHITECTURE PRINCIPLES
//   1. SOFT DELETE PATTERN — Every mutable model has:
//        isDeleted Boolean @default(false)
//        deletedAt DateTime?
//      DELETE endpoints set isDeleted=true, write AuditLog, NEVER hard-delete
//   2. JSON COLUMNS — Complex nested data stored as TEXT (JSON strings):
//        User.panels, User.actions           → PanelPermissions JSON
//        Christian.baptism, eucharist, etc.  → SacramentData JSON
//        Contribution.categories, monthlyTracker → String[] + Record<month,bool>
//      Parsed by backend route handlers; Prisma treats them as opaque Strings
//   3. UUID PRIMARY KEYS — All models use @id @default(uuid()) for global uniqueness
//   4. TIMESTAMPS — createdAt @default(now()), updatedAt @updatedAt on all models
//   5. SINGLETON SETTINGS — PanelPermissions, PushPaymentSettings use id="default"
//      (enforced by @id @default("default")) — one row per setting type
//
// MODEL MAP BY DOMAIN
//   ┌─────────────────────┬────────────────────────────────────────────────────────┐
//   │ Domain              │ Models                                                   │
//   ├─────────────────────┼────────────────────────────────────────────────────────┤
//   │ Authentication      │ User, PanelPermissions                                   │
//   │ Parish Registry     │ Christian, Contribution, Transfer, BilledItem, Death    │
//   │ Finance             │ Deposit, Creditor, Debtor, Expense, Ledger, LedgerMovement│
//   │ Inventory           │ InventoryItem, Delivery, Sale, StockTake, StockIssue,   │
//   │                     │   InventoryPriceAuditLog                                 │
//   │ Human Resources     │ Employee, Payroll, Leave, Recruitment, RecruitmentApplicant│
//   │ Audit & Ops         │ AuditLog, PushPaymentSettings                            │
//   └─────────────────────┴────────────────────────────────────────────────────────┘
//
// KEY RELATIONSHIPS
//   Christian 1──● Contribution (christianId)
//   Christian 1──● Transfer     (christianId)
//   Christian 1──● BilledItem   (christianId, optional - walk-ins allowed)
//   Christian 1──● Death        (christianId)
//   Employee  1──● Payroll      (employeeId)
//   Employee  1──● Leave        (employeeId)
//   Recruitment 1──● RecruitmentApplicant (recruitmentId)
//
// INDEXES (query optimization)
//   Christian:   status, scc, localChurch (filter-heavy columns)
//   Contribution/Transfer/Death/BilledItem: christianId (FK lookups)
//   Payroll/Leave/RecruitmentApplicant: employeeId/recruitmentId (FK lookups)
//   InventoryPriceAuditLog: itemId, createdAt (history queries)
//   AuditLog: entityName, entityId (trash & audit filters)
//
// SENSITIVE DATA HANDLING
//   - User.passwordHash: bcrypt hash, NEVER returned in API responses
//   - PushPaymentSettings.consumerKey/Secret: plaintext in DB, MASKED in API
//   - AuditLog.metadataSnapshot: passwordHash STRIPPED before write
//   - Export/Import: secrets stripped, M-Pesa credentials masked
//
// MIGRATION NOTES
//   - Run `npx prisma migrate dev --name <description>` for schema changes
//   - JSON column changes require NO migration (just update Zod schemas + types)
//   - Adding required fields: provide @default or make nullable first
//
// RELATED FILES
//   - backend/src/routes/*.ts          → Zod validation (mirror these fields)
//   - src/types.ts                     → Frontend interfaces (mirror these fields)
//   - backend/src/lib/audit.ts         → softDelete, restoreFromLog (use models)
//   - backend/prisma/seed.ts           → Development seed data
// =============================================================================

// Prisma generator — produces the typed Prisma Client used by all backend code.
// The "clientjs" output is required for ESM compatibility with Vite/tsx.
generator client {
  provider = "prisma-client-js"
}

// Database connection — reads DATABASE_URL from the environment.
// PostgreSQL connection string via DATABASE_URL env var.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  title        String?
  role                  String    @default("staff")
  isActive              Boolean   @default(true)
  panels                String?
  actions               String?
  resetTokenHash        String?
  resetTokenExpires     DateTime?
  resetFailedAttempts   Int       @default(0)
  mustChangePassword    Boolean   @default(false)
  loginFailedAttempts   Int       @default(0)
  lockedUntil           DateTime?
  lastLoginAt           DateTime?
  lastActiveAt          DateTime?
  isDeleted             Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

model PanelPermissions {
  id      String @id @default("default")
  panels  String
  actions String

  @@map("panel_permissions")
}

model PushPaymentSettings {
  id             String @id @default("default")
  paybill        String @default("")
  accountFormat  String @default("")
  consumerKey    String @default("")
  consumerSecret String @default("")
  mode           String @default("sandbox")
  testPhone      String @default("")
  testAmount     String @default("")

  @@map("push_payment_settings")
}

model Christian {
  id            String   @id @default(uuid())
  regNo         String   @unique
  nationalId    String
  baptismalName String
  secondName    String
  sirName       String
  phone         String
  diocese       String
  parish        String
  localChurch   String
  scc           String
  status        String   @default("Active")
  baptism       String?
  eucharist     String?
  confirmation  String?
  marriage      String?
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  contributions Contribution[]
  transfers     Transfer[]
  billedItems   BilledItem[]
  deaths        Death[]

  @@index([status])
  @@index([scc])
  @@index([localChurch])
  @@map("christians")
}

model Contribution {
  id             String    @id @default(uuid())
  christianId    String
  christian      Christian @relation(fields: [christianId], references: [id])
  memberName     String
  regNo          String
  categories     String
  otherCategory  String?
  monthlyTracker String
  amountKES      Float
  date           String
  isDeleted      Boolean  @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([christianId])
  @@map("contributions")
}

model Transfer {
  id           String    @id @default(uuid())
  christianId  String
  christian    Christian @relation(fields: [christianId], references: [id])
  memberName   String
  diocese      String
  parish       String
  localChurch  String
  scc          String
  date         String
  isDeleted    Boolean  @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([christianId])
  @@map("transfers")
}

model BilledItem {
  id           String     @id @default(uuid())
  christianId  String?
  christian    Christian? @relation(fields: [christianId], references: [id])
  memberName   String
  isWalkIn     Boolean    @default(false)
  category     String
  item         String
  unitFee      Float
  quantity     Int
  totalAmount  Float
  date         String
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())

  @@map("billed_items")
}

model Death {
  id            String    @id @default(uuid())
  christianId   String
  christian     Christian @relation(fields: [christianId], references: [id])
  memberName    String
  placeOfDeath  String
  dateOfDeath   String
  dateOfBurial  String
  ministerName  String
  remarks       String    @default("")
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([christianId])
  @@map("deaths")
}

model AuditLog {
  id               String   @id @default(uuid())
  // PascalCase Prisma delegate name of the soft-deleted model (e.g. "Christian").
  entityName       String
  // Row id of the soft-deleted/restored record within that model.
  entityId         String
  // "DELETE" or "RESTORE" — drives the Trash & Audit UI.
  action           String   @default("DELETE")
  // Actor id + cached display name (resolved at write time so the trail survives
  // the actor's own account being deleted later).
  deletedBy        String?
  deletedByName    String?
  // Full JSON snapshot of the record at mutation time. passwordHash is stripped
  // before writing so credentials never persist in the audit trail.
  metadataSnapshot String
  createdAt        DateTime @default(now())

  @@index([entityName])
  @@index([entityId])
  @@map("audit_logs")
}

model Deposit {
  id           String   @id @default(uuid())
  date         String
  amount       Float
  bankName     String
  accountNo    String
  sourceOfCash String
  refNo        String
  depositedBy  String
  isDeleted    Boolean  @default(false)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())

  @@map("deposits")
}

model Creditor {
  id          String   @id @default(uuid())
  vendor      String
  description String
  invoiceNo   String
  amountOwed  Float
  dueDate     String
  status      String   @default("Pending")
  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("creditors")
}

model Debtor {
  id               String   @id @default(uuid())
  memberName       String
  contributionType String
  amount           Float
  status           String   @default("Outstanding")
  isDeleted        Boolean  @default(false)
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("debtors")
}

model Expense {
  id            String   @id @default(uuid())
  date          String
  category      String
  description   String
  amount        Float
  paymentMethod String
  voucherNo     String
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
  createdAt     DateTime @default(now())

  @@map("expenses")
}

model Ledger {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  type      String
  cashier   String
  balance   Float    @default(0)
  isDeleted Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ledgers")
}

model LedgerMovement {
  id        String   @id @default(uuid())
  amount    Float
  time      String
  from      String
  to        String
  notes     String?
  isDeleted Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())

  @@map("ledger_movements")
}

model InventoryItem {
  id        String   @id @default(uuid())
  name      String
  sku       String   @unique
  category  String
  cost      Float
  price     Float
  stock     Int      @default(0)
  reorder   Int      @default(0)
  isDeleted Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inventory_items")
}

model Delivery {
  id        String   @id @default(uuid())
  supplier  String
  inv       String
  date      String
  units     Int
  cat       String
  total     Float
  isDeleted Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())

  @@map("deliveries")
}

model Sale {
  id        String   @id @default(uuid())
  item      String
  time      String
  amount    Float
  isDeleted Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())

  @@map("sales")
}

model StockTake {
  id        String   @id @default(uuid())
  name      String
  sku       String
  system    Int
  physical  Int
  notes     String   @default("")
  isDeleted Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stock_takes")
}

model StockIssue {
  id        String   @id @default(uuid())
  item      String
  dest      String
  isDeleted Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())

  @@map("stock_issues")
}

model Employee {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  role      String
  phone     String
  email     String
  hireDate  String
  isDeleted Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payrolls  Payroll[]
  leaves    Leave[]

  @@map("employees")
}

model Payroll {
  id             String    @id @default(uuid())
  employeeId     String
  employee       Employee? @relation(fields: [employeeId], references: [id])
  period         String
  basicSalary    Float
  allowances     Float    @default(0)
  deductions     Float    @default(0)
  netPay         Float
  status         String   @default("Draft")
  notes          String?
  isDeleted      Boolean  @default(false)
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([employeeId])
  @@map("payrolls")
}

model Leave {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  type         String
  startDate    String
  endDate      String
  days         Int
  reason       String
  status       String   @default("Pending")
  approvedBy   String?
  notes        String?
  isDeleted    Boolean  @default(false)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([employeeId])
  @@map("leaves")
}

model Recruitment {
  id           String   @id @default(uuid())
  position     String
  department   String
  description  String
  requirements String?
  status       String   @default("Open")
  datePosted   String
  closingDate  String?
  notes        String?
  isDeleted    Boolean  @default(false)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  applicants   RecruitmentApplicant[]

  @@map("recruitments")
}

model RecruitmentApplicant {
  id              String      @id @default(uuid())
  recruitmentId   String
  recruitment     Recruitment @relation(fields: [recruitmentId], references: [id])
  name            String
  email           String
  phone           String?
  cvSummary       String?
  status          String      @default("Pending")
  notes           String?
  isDeleted       Boolean     @default(false)
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([recruitmentId])
  @@map("recruitment_applicants")
}

// Append-only price audit trail: every cost/price change on an inventory item
// writes one row so administrators can review retail/cost history over time.
model InventoryPriceAuditLog {
  id        String   @id @default(uuid())
  itemId    String
  itemName  String
  sku       String
  oldCost   Float?
  newCost   Float?
  oldPrice  Float?
  newPrice  Float?
  actorName String
  createdAt DateTime @default(now())

  @@index([itemId])
  @@index([createdAt])
  @@map("inventory_price_audit_logs")
}

// ── Administration / Ops ─────────────────────────────────────────────────────

// Singleton row (id="default") holding first-run wizard state and parish identity.
// Created lazily by GET /api/settings; PATCH flips setupCompleted once the wizard
// is finished so the login screen can redirect new users into onboarding.
model SystemSettings {
  id             String   @id @default("default")
  parishName     String   @default("")
  diocese        String   @default("")
  setupCompleted Boolean  @default(false)
  setupStep      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("system_settings")
}

// Singleton row (id="default") storing Africa's Talking SMS gateway credentials.
// Used by the SMS service to send member notifications (birthdays, reminders, etc.).
model SmsSettings {
  id        String   @id @default("default")
  enabled   Boolean  @default(false)
  username  String   @default("sandbox")
  apiKey    String   @default("")
  senderId  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sms_settings")
}
