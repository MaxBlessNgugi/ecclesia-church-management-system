// =============================================================================
// Ecclesia CMS — Prisma Database Schema
// =============================================================================
//
// DATABASE: PostgreSQL (env: DATABASE_URL)
// ORM:      Prisma Client (generate: `npx prisma generate`)
// MIGRATIONS: `npx prisma migrate dev` (dev) / `prisma migrate deploy` (prod)
// SEED:     `npx prisma db seed` → backend/prisma/seed.ts
//
// ARCHITECTURE PRINCIPLES
//   1. SOFT DELETE PATTERN — Every mutable model has:
//        isDeleted Boolean @default(false)
//        deletedAt DateTime?
//      DELETE endpoints set isDeleted=true, write AuditLog, NEVER hard-delete
//   2. JSON COLUMNS — Complex nested data stored as native Prisma Json:
//        User.panels, User.actions           → PanelPermissions JSON (Json)
//        Christian.baptism, eucharist, etc.  → SacramentData JSON (Json)
//        Contribution.categories, monthlyTracker → String[] + Record<month,bool> (Json)
//      Prisma returns parsed JS objects; no manual JSON.parse/stringify needed
//   3. UUID PRIMARY KEYS — All models use @id @default(uuid()) for global uniqueness
//   4. TIMESTAMPS — createdAt @default(now()), updatedAt @updatedAt on all models
//   5. SINGLETON SETTINGS — PanelPermissions, PushPaymentSettings use id="default"
//      (enforced by @id @default("default")) — one row per setting type
//
// MODEL MAP BY DOMAIN
//   ┌─────────────────────┬────────────────────────────────────────────────────────┐
//   │ Domain              │ Models                                                   │
//   ├─────────────────────┼────────────────────────────────────────────────────────┤
//   │ Authentication      │ User, PanelPermissions                                   │
//   │ Parish Registry     │ Christian, Contribution, Transfer, BilledItem, Death    │
//   │ Finance             │ Deposit, Creditor, Debtor, Expense, Ledger, LedgerMovement│
//   │ Inventory           │ InventoryItem, Delivery, Sale, StockTake, StockIssue,   │
//   │                     │   InventoryPriceAuditLog                                 │
//   │ Human Resources     │ Employee, Payroll, Leave, Recruitment, RecruitmentApplicant│
//   │ Audit & Ops         │ AuditLog, PushPaymentSettings                            │
//   └─────────────────────┴────────────────────────────────────────────────────────┘
//
// KEY RELATIONSHIPS
//   Christian 1──● Contribution (christianId)
//   Christian 1──● Transfer     (christianId)
//   Christian 1──● BilledItem   (christianId, optional - walk-ins allowed)
//   Christian 1──● Death        (christianId)
//   Employee  1──● Payroll      (employeeId)
//   Employee  1──● Leave        (employeeId)
//   Recruitment 1──● RecruitmentApplicant (recruitmentId)
//
// INDEXES (query optimization)
//   Christian:   status, scc, localChurch (filter-heavy columns)
//   Contribution/Transfer/Death/BilledItem: christianId (FK lookups)
//   Payroll/Leave/RecruitmentApplicant: employeeId/recruitmentId (FK lookups)
//   InventoryPriceAuditLog: itemId, createdAt (history queries)
//   AuditLog: entityName, entityId (trash & audit filters)
//
// SENSITIVE DATA HANDLING
//   - User.passwordHash: bcrypt hash, NEVER returned in API responses
//   - PushPaymentSettings.consumerKey/Secret: plaintext in DB, MASKED in API
//   - AuditLog.metadataSnapshot: passwordHash STRIPPED before write
//   - Export/Import: secrets stripped, M-Pesa credentials masked
//
// MIGRATION NOTES
//   - Development: `npx prisma migrate dev --name <description>`
//   - Production:  `npx prisma migrate deploy`
//   - Adding required fields: provide @default or make nullable first
//
// RELATED FILES
//   - backend/src/routes/*.ts          → Zod validation (mirror these fields)
//   - src/types.ts                     → Frontend interfaces (mirror these fields)
//   - backend/src/lib/audit.ts         → softDelete, restoreFromLog (use models)
//   - backend/prisma/seed.ts           → Development seed data
// =============================================================================

// Prisma generator — produces the typed Prisma Client used by all backend code.
// The "clientjs" output is required for ESM compatibility with Vite/tsx.
generator client {
  provider = "prisma-client-js"
}

// Database connection — reads DATABASE_URL from the environment.
// PostgreSQL connection string via DATABASE_URL env var.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enum types for closed-set string fields ──────────────────────────────────
// These enforce allowed values at the database level. The app also validates
// via Zod, but the DB is the backstop against bypassed API calls.

enum UserRole {
  super_admin
  admin
  staff
  viewer
}

enum ChristianStatus {
  Active
  Transferred
  Deceased
  Inactive
}

enum CreditorStatus {
  Pending
  Overdue
  Scheduled
  Paid
}

// Debtor.status uses CHECK constraint (values contain spaces)
// enum DebtorStatus { ... } — not suitable for "Partially Paid"

enum PayrollStatus {
  Draft
  Approved
  Paid
  Cancelled
}

enum LeaveStatus {
  Pending
  Approved
  Rejected
  Cancelled
}

// Recruitment.status uses CHECK constraint ("On Hold" contains a space)
// enum RecruitmentStatus { ... } — not suitable for "On Hold"

enum RecruitmentApplicantStatus {
  Pending
  Reviewed
  Interviewed
  Accepted
  Rejected
}

enum AuditAction {
  DELETE
  RESTORE
}

enum PaymentMode {
  sandbox
  live
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  title        String?
  role                  UserRole  @default(staff)
  isActive              Boolean   @default(true)
  panels                Json?
  actions               Json?
  resetTokenHash        String?
  resetTokenExpires     DateTime?
  resetFailedAttempts   Int       @default(0)
  mustChangePassword    Boolean   @default(false)
  loginFailedAttempts   Int       @default(0)
  lockedUntil           DateTime?
  lastLoginAt           DateTime?
  lastActiveAt          DateTime?
  isDeleted             Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

model PanelPermissions {
  id      String @id @default("default")
  panels  Json
  actions Json

  @@map("panel_permissions")
}

model PushPaymentSettings {
  id             String @id @default("default")
  paybill        String @default("")
  accountFormat  String    @default("")
  consumerKey    String    @default("")
  consumerSecret String    @default("")
  mode           PaymentMode    @default(sandbox)
  testPhone      String @default("")
  testAmount     String @default("")

  @@map("push_payment_settings")
}

model Christian {
  id            String   @id @default(uuid())
  regNo         String   @unique
  nationalId    String
  baptismalName String
  secondName    String
  sirName       String
  phone         String
  diocese       String
  parish        String
  localChurch   String
  scc           String
  status        ChristianStatus @default(Active)
  baptism       Json?
  eucharist     Json?
  confirmation  Json?
  marriage      Json?
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  contributions Contribution[]
  transfers     Transfer[]
  billedItems   BilledItem[]
  deaths        Death[]

  @@index([isDeleted, status, createdAt])
  @@index([status, createdAt])  // list endpoint: WHERE status + ORDER BY createdAt DESC
  @@index([scc])
  @@index([localChurch])
  @@map("christians")
}

model Contribution {
  id             String    @id @default(uuid())
  christianId    String
  christian      Christian @relation(fields: [christianId], references: [id])
  memberName     String
  regNo          String
  categories     Json
  otherCategory  String?
  monthlyTracker Json
  amountKES      Decimal           @db.Decimal(12, 2)
  date           DateTime
  isDeleted      Boolean  @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([isDeleted, date])
  @@index([isDeleted, christianId])
  @@index([christianId])
  @@index([date])
  @@map("contributions")
}

model Transfer {
  id           String    @id @default(uuid())
  christianId  String
  christian    Christian @relation(fields: [christianId], references: [id])
  memberName   String
  diocese      String
  parish       String
  localChurch  String
  scc          String
  date         DateTime
  isDeleted    Boolean  @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([christianId])
  @@index([date])
  @@map("transfers")
}

model BilledItem {
  id           String     @id @default(uuid())
  christianId  String?
  christian    Christian? @relation(fields: [christianId], references: [id])
  memberName   String
  isWalkIn     Boolean    @default(false)
  category     String
  item         String
  unitFee      Decimal           @db.Decimal(12, 2)
  quantity     Int
  totalAmount  Decimal           @db.Decimal(12, 2)
  date         DateTime
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())

  @@index([date])
  @@map("billed_items")
}

model Death {
  id            String    @id @default(uuid())
  christianId   String
  christian     Christian @relation(fields: [christianId], references: [id])
  memberName    String
  placeOfDeath  String
  dateOfDeath   DateTime
  dateOfBurial  DateTime
  ministerName  String
  remarks       String    @default("")
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([christianId])
  @@map("deaths")
}

model AuditLog {
  id               String   @id @default(uuid())
  // PascalCase Prisma delegate name of the soft-deleted model (e.g. "Christian").
  entityName       String
  // Row id of the soft-deleted/restored record within that model.
  entityId         String
  // "DELETE" or "RESTORE" — drives the Trash & Audit UI.
  action           AuditAction @default(DELETE)
  // Actor id + cached display name (resolved at write time so the trail survives
  // the actor's own account being deleted later).
  deletedBy        String?
  deletedByName    String?
  // Full JSON snapshot of the record at mutation time. passwordHash is stripped
  // before writing so credentials never persist in the audit trail.
  metadataSnapshot String
  createdAt        DateTime @default(now())

  @@index([entityName, action])  // audit list: WHERE entityName + action
  @@index([entityId])
  @@index([deletedByName])       // audit list: WHERE deletedByName (actor filter)
  @@map("audit_logs")
}

model Deposit {
  id           String   @id @default(uuid())
  date         DateTime
  amount       Decimal           @db.Decimal(12, 2)
  bankName     String
  accountNo    String
  sourceOfCash String
  refNo        String
  depositedBy  String
  isDeleted    Boolean  @default(false)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([date])
  @@index([refNo])  // sequential refNo generation: ORDER BY refNo DESC
  @@map("deposits")
}

model Creditor {
  id          String   @id @default(uuid())
  vendor      String
  description String
  invoiceNo   String
  amountOwed  Decimal           @db.Decimal(12, 2)
  dueDate     DateTime
  status      CreditorStatus @default(Pending)
  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])  // dashboard count: WHERE status IN ('Pending','Overdue','Scheduled')
  @@map("creditors")
}

model Debtor {
  id               String   @id @default(uuid())
  memberName       String
  contributionType String
  amount           Decimal           @db.Decimal(12, 2)
  status           String   @default("Outstanding")  // CHECK: IN ('Outstanding','Partially Paid','Paid')
  isDeleted        Boolean  @default(false)
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])  // dashboard count: WHERE status IN ('Outstanding','Partially Paid')
  @@map("debtors")
}

model Expense {
  id            String   @id @default(uuid())
  date          DateTime
  category      String
  description   String
  amount        Decimal           @db.Decimal(12, 2)
  paymentMethod String
  voucherNo     String
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
  createdAt     DateTime @default(now())

  @@index([date])
  @@index([voucherNo])  // sequential voucherNo generation: ORDER BY voucherNo DESC
  @@map("expenses")
}

model Ledger {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  type      String
  cashier   String
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  isDeleted Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ledgers")
}

model LedgerMovement {
  id        String   @id @default(uuid())
  amount    Decimal           @db.Decimal(12, 2)
  time      DateTime
  from      String
  to        String
  notes     String?
  isDeleted Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())

  @@map("ledger_movements")
}

model InventoryItem {
  id        String   @id @default(uuid())
  name      String
  sku       String   @unique
  category  String
  cost      Decimal           @db.Decimal(12, 2)
  price     Decimal           @db.Decimal(12, 2)
  stock     Int      @default(0)
  reorder   Int      @default(0)
  isDeleted Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])  // sale route: findFirst WHERE name = item
  @@map("inventory_items")
}

model Delivery {
  id        String   @id @default(uuid())
  supplier  String
  inv       String
  date      DateTime
  units     Int
  cat       String
  total     Decimal           @db.Decimal(12, 2)
  isDeleted Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())

  @@index([date])
  @@map("deliveries")
}

model Sale {
  id        String   @id @default(uuid())
  item      String
  time      DateTime
  amount    Decimal           @db.Decimal(12, 2)
  isDeleted Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())

  @@index([item])  // reports: WHERE item CONTAINS
  @@map("sales")
}

model StockTake {
  id        String   @id @default(uuid())
  name      String
  sku       String
  system    Int
  physical  Int
  notes     String   @default("")
  isDeleted Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stock_takes")
}

model StockIssue {
  id        String   @id @default(uuid())
  item      String
  dest      String
  isDeleted Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())

  @@map("stock_issues")
}

model Employee {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  role      String
  phone     String
  email     String   @unique
  hireDate  DateTime
  isDeleted Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payrolls  Payroll[]
  leaves    Leave[]

  @@map("employees")
}

model Payroll {
  id             String    @id @default(uuid())
  employeeId     String
  employee       Employee? @relation(fields: [employeeId], references: [id])
  period         String  // "2024-06" or "June 2026" — period identifier, NOT a date
  basicSalary    Decimal           @db.Decimal(12, 2)
  allowances     Decimal  @default(0) @db.Decimal(12, 2)
  deductions     Decimal  @default(0) @db.Decimal(12, 2)
  netPay         Decimal           @db.Decimal(12, 2)
  status         PayrollStatus @default(Draft)
  notes          String?
  isDeleted      Boolean  @default(false)
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([employeeId])
  @@index([status])  // payroll list: WHERE status
  @@map("payrolls")
}

model Leave {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  type         String
  startDate    DateTime
  endDate      DateTime
  days         Int
  reason       String
  status       LeaveStatus @default(Pending)
  approvedBy   String?
  notes        String?
  isDeleted    Boolean  @default(false)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([employeeId])
  @@index([status])  // leave list: WHERE status
  @@map("leaves")
}

model Recruitment {
  id           String   @id @default(uuid())
  position     String
  department   String
  description  String
  requirements String?
  status       String   @default("Open")  // CHECK: IN ('Open','Closed','On Hold','Cancelled')
  datePosted   DateTime
  closingDate  DateTime?
  notes        String?
  isDeleted    Boolean  @default(false)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  applicants   RecruitmentApplicant[]

  @@index([status])  // recruitment list: WHERE status
  @@map("recruitments")
}

model RecruitmentApplicant {
  id              String      @id @default(uuid())
  recruitmentId   String
  recruitment     Recruitment @relation(fields: [recruitmentId], references: [id])
  name            String
  email           String
  phone           String?
  cvSummary       String?
  status          RecruitmentApplicantStatus @default(Pending)
  notes           String?
  isDeleted       Boolean     @default(false)
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([recruitmentId])
  @@index([status])  // applicant list: WHERE status
  @@map("recruitment_applicants")
}

// Append-only price audit trail: every cost/price change on an inventory item
// writes one row so administrators can review retail/cost history over time.
model InventoryPriceAuditLog {
  id        String   @id @default(uuid())
  itemId    String
  itemName  String
  sku       String
  oldCost   Decimal? @db.Decimal(12, 2)
  newCost   Decimal? @db.Decimal(12, 2)
  oldPrice  Decimal? @db.Decimal(12, 2)
  newPrice  Decimal? @db.Decimal(12, 2)
  actorName String
  createdAt DateTime @default(now())

  @@index([itemId])
  @@index([createdAt])
  @@map("inventory_price_audit_logs")
}

// ── Administration / Ops ─────────────────────────────────────────────────────

// Singleton row (id="default") holding first-run wizard state and parish identity.
// Created lazily by GET /api/parish; PUT flips setupCompleted once the wizard
// is finished so the login screen can redirect new users into onboarding.
model ParishSettings {
  id              String   @id @default("default")
  name            String   @default("")
  diocese         String   @default("")
  localChurch     String   @default("")
  sccLabel        String   @default("Jumuiya")
  county          String   @default("")
  country         String   @default("Kenya")
  address         String   @default("")
  phone           String   @default("")
  email           String   @default("")
  motto           String   @default("")
  logoData        String?
  setupCompleted  Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  @@map("system_settings")
}

// Singleton row (id="default") storing Africa's Talking SMS gateway credentials.
// Used by the SMS service to send member notifications (birthdays, reminders, etc.).
model SmsSettings {
  id        String   @id @default("default")
  enabled   Boolean  @default(false)
  username  String   @default("sandbox")
  apiKey    String   @default("")
  senderId  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sms_settings")
}
