[TEMPLATE]
# PostgreSQL — multi-user concurrent database
DATABASE_URL="postgresql://postgres:ecclesia@localhost:5432/ecclesia?schema=public"

# JWT — in production this MUST be a strong random value; the app refuses to
# start if it is missing or still the dev default. In development it is
# auto-generated and persisted here on first start.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="ecclesia-local-dev-secret-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV=development

# Client URL for Socket.IO CORS (set to your production domain in production)
CLIENT_URL="http://localhost:3000"

# Comma-separated list of allowed CORS origins (e.g. "http://localhost:3000,http://ecclesia.local").
# Leave empty or unset to allow all origins (dev-friendly / LAN).
# In production, set this to restrict which origins can access the API.
# Requests without an Origin header (e.g. curl, health checks) are always allowed.
CORS_ORIGINS=""

# Backups — pg_dump → gzip → optional AES-256-GCM → SHA-256 sidecar.
# BACKUP_DIR holds artifacts; BACKUP_KEEP prunes the oldest snapshots.
# The scheduler backs up on boot if the newest verified snapshot is older than
# BACKUP_INTERVAL_HOURS, re-checking every 6h. Set BACKUP_DISABLED=true to turn
# the automatic scheduler off (Docker does this by default). Requires pg_dump.
# Optional encryption: BACKUP_ENCRYPTION_KEY = 64 hex chars (32 bytes → AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypting the backups is recommended when BACKUP_DEST_DIR is a shared/cloud
# folder. Losing this key makes every encrypted artifact unrestorable — store
# it safely (e.g. password manager) IN ADDITION to backend/.env.
# Optional: BACKUP_LOG_FILE=/path/backup.log appends one line per scheduler event.
BACKUP_DIR="./backups"
BACKUP_KEEP="14"
BACKUP_INTERVAL_HOURS="24"
BACKUP_DEST_DIR=""
BACKUP_DISABLED="false"
BACKUP_ENCRYPTION_KEY=""
BACKUP_LOG_FILE=""

# Outbound email (nodemailer) — used to deliver password-reset codes.
# NOTE: SMTP settings saved in the first-run setup wizard or Administration
# (mail_settings table) take precedence over these env vars when enabled.
# Without SMTP_HOST the backend runs in DEV FALLBACK mode: emails are not
# sent anywhere but are written to backend/logs/outbox/*.txt and printed in
# the backend console. Configure a real SMTP relay for production, e.g.:
#   Gmail:        smtp.gmail.com:587  (use an App Password, not your login)
#   Brevo:        smtp-relay.brevo.com:587
#   Mailgun:      smtp.mailgun.org:587
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"          # "true" for implicit TLS (port 465)
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="ECCLESIA <no-reply@ecclesia.local>"

# Dev SMS outbox — set to "true" to demo birthday greetings and broadcasts
# without a real Africa's Talking account. When no gateway is configured,
# messages are written to backend/logs/sms-outbox/*.txt and reported as sent
# (nothing actually leaves the machine). Leave unset in production.
SMS_DEV_OUTBOX=""

# First Super Admin (seeded on first run). If SUPER_ADMIN_PASSWORD is unset a
# random password is generated and printed once to the console; the account
# always requires a password change at first sign-in.
SUPER_ADMIN_EMAIL="maxblessngugi@ecclesia.local"
SUPER_ADMIN_PASSWORD=""
SUPER_ADMIN_NAME="Max Bless Ngugi"
