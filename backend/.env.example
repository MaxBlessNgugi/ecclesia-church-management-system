# SQLite — fully local, no external database required
DATABASE_URL="file:./dev.db"

# JWT — in production this MUST be a strong random value; the app refuses to
# start if it is missing or still the dev default. In development it is
# auto-generated and persisted here on first start.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="ecclesia-local-dev-secret-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV=development

# Backups — SQLite snapshots are written to BACKUP_DIR daily (default 24h) and
# rotated keeping BACKUP_KEEP files. Set BACKUP_DEST_DIR to a network share /
# cloud-synced folder to mirror snapshots off-site. Set BACKUP_DISABLED=true to
# turn off the automatic scheduler.
BACKUP_DIR="./backups"
BACKUP_KEEP="14"
BACKUP_INTERVAL_HOURS="24"
BACKUP_DEST_DIR=""
BACKUP_DISABLED="false"

# First Super Admin (seeded on first run). If SUPER_ADMIN_PASSWORD is unset a
# random password is generated and printed once to the console; the account
# always requires a password change at first sign-in.
SUPER_ADMIN_EMAIL="maxblessngugi@ecclesia.local"
SUPER_ADMIN_PASSWORD=""
SUPER_ADMIN_NAME="Max Bless Ngugi"
