{
  "name": "ecclesia-backend",
  "version": "1.0.0",
  "description": "Ecclesia Church Management System — fully local backend (SQLite)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "setup": "npm install && npx prisma db push && npm run db:seed",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:clear:demo": "tsx scripts/clear-demo.ts",
    "db:studio": "prisma studio",
    "backup": "tsx scripts/backup.ts",
    "export": "tsx scripts/export.ts",
    "restore": "tsx scripts/restore.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "church",
    "erp",
    "parish",
    "ecclesia"
  ],
  "author": "Max Bless Ngugi",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@prisma/client": "5.22.0",
    "africastalking": "^0.8.3",
    "archiver": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.7.0",
    "@types/supertest": "^7.2.1",
    "prisma": "5.22.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
