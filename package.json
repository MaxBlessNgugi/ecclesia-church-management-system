{
  "name": "ecclesia-chms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"VITE,BACKEND\" -c \"green,blue\" \"vite --port=3000 --strictPort --host=0.0.0.0\" \"npm run dev --prefix backend\"",
    "backend": "npm run dev --prefix backend",
    "backend:setup": "npm install --prefix backend && npm run db:generate --prefix backend && npm run db:migrate:deploy --prefix backend && npm run db:seed --prefix backend",
    "backend:build": "npm run build --prefix backend",
    "setup": "npm install && npm run backend:setup",
    "server": "npm run backend",
    "build": "vite build && npm run backend:build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:e2e": "cd e2e && npx playwright test --project=fast",
    "tour": "cd e2e && npx playwright test --project=tour",
    "test:report": "npx playwright show-report playwright-report"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-to-print": "^3.3.0",
    "socket.io-client": "^4.8.3",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  }
}
