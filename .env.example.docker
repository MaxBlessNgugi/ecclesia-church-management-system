# =============================================================================
# Docker Compose Environment Variables
# =============================================================================
# Copy to .env and fill in required values:
#   cp .env.example.docker .env
#
# Generate JWT_SECRET:
#   openssl rand -hex 48          (Linux/macOS)
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# =============================================================================

# ── Required ────────────────────────────────────────────────────────────────
POSTGRES_USER=ecclesia
# Password must NOT contain: @ : / # or spaces (breaks DATABASE_URL)
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=ecclesia
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_96_CHAR_HEX_STRING

# ── Optional ────────────────────────────────────────────────────────────────
JWT_EXPIRES_IN=7d
# APP_PORT is the host port mapped to the app. Port 80 lets users reach the
# system at the bare hostname (http://ecclesia.local) with no :5000 suffix.
# If another service (IIS, Docker proxy) owns port 80, fall back to e.g. 5000.
APP_PORT=80
CLIENT_URL=http://ecclesia.local
CORS_ORIGINS=
SUPER_ADMIN_EMAIL=maxblessngugi@ecclesia.local
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Max Bless Ngugi
