# =============================================================================
# Docker Compose Environment Variables
# =============================================================================
# Copy to .env and fill in required values:
#   cp .env.example.docker .env
#
# Generate JWT_SECRET:
#   openssl rand -hex 48          (Linux/macOS)
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# =============================================================================

# ── Required ────────────────────────────────────────────────────────────────
POSTGRES_USER=ecclesia
# Password must NOT contain: @ : / # or spaces (breaks DATABASE_URL)
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=ecclesia
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_96_CHAR_HEX_STRING

# ── Optional ────────────────────────────────────────────────────────────────
JWT_EXPIRES_IN=7d
# APP_PORT is the host port mapped to the app (the app always listens on 5000
# inside its container). Port 80 lets users reach the system at the bare
# hostname — http://ecclesia.local or http://<server-ip> — with no :port suffix.
# If another service (IIS, Docker proxy) owns port 80, fall back to e.g. 5000
# and use the :5000 suffix in URLs.
APP_PORT=80
# Origin restriction (advanced) for the API and real-time sync. Leave both
# CLIENT_URL and CORS_ORIGINS empty (the trusted-LAN default): the app accepts
# any browser that reached it, so real-time sync works at http://localhost,
# http://ecclesia.local and http://<server-ip> alike. For a locked-down
# deployment (e.g. HTTPS behind Caddy), set CLIENT_URL to the address clients
# use and/or list every allowed origin in CORS_ORIGINS (comma-separated).
CLIENT_URL=
CORS_ORIGINS=
SUPER_ADMIN_EMAIL=maxblessngugi@ecclesia.local
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Max Bless Ngugi
