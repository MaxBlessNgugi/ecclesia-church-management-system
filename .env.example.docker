# =============================================================================
# Ecclesia CMS — Docker Compose Environment Variables
# =============================================================================
# Copy this file to .env and fill in the required values:
#
#   cp .env.example.docker .env
#
# Generate a secure JWT_SECRET (pick ONE method):
#
#   Node.js:    node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   Linux:      openssl rand -hex 48
#   macOS:      openssl rand -hex 48
#
# NEVER commit .env to version control.
# =============================================================================

# ── Required ────────────────────────────────────────────────────────────────

# PostgreSQL credentials (must match between POSTGRES_* and DATABASE_URL)
POSTGRES_USER=ecclesia
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=ecclesia

# JWT secret — app REFUSES to start without a strong value in production
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_96_CHAR_HEX_STRING

# ── Optional ────────────────────────────────────────────────────────────────

# JWT token expiry (default: 7 days)
JWT_EXPIRES_IN=7d

# Port published to the host (default: 5000)
# Change if port 5000 is already in use on the server
APP_PORT=5000

# Client URL — the origin browsers use to access the app
# Single machine:   http://localhost:5000
# LAN access:       http://192.168.1.100:5000  (server's LAN IP)
CLIENT_URL=http://localhost:5000

# CORS allowed origins — comma-separated list
# Leave empty to allow all origins (safe for parish LAN networks)
# Example: "http://localhost:5000,http://192.168.1.100:5000,http://ecclesia.local:5000"
CORS_ORIGINS=

# First admin account (created on first seed)
# If SUPER_ADMIN_PASSWORD is empty, a random password is generated and
# printed to docker compose logs — check logs after first startup.
SUPER_ADMIN_EMAIL=maxblessngugi@ecclesia.local
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Max Bless Ngugi

# Backup directory (mounted into the app container)
BACKUP_DIR=./backups
