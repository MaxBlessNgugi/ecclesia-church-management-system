# =============================================================================
# Ecclesia CMS — Docker Compose Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
#
#   cp .env.example.docker .env
#
# Generate a secure JWT_SECRET:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Or on Linux/macOS:
#   openssl rand -hex 48
# =============================================================================

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# Database credentials — MUST match between POSTGRES_* and DATABASE_URL
POSTGRES_USER=ecclesia
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=ecclesia

# ── Application ─────────────────────────────────────────────────────────────
# JWT secret — REQUIRED, app refuses to start without it in production
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_96_CHAR_HEX_STRING

# JWT token expiry (default 7 days)
JWT_EXPIRES_IN=7d

# Port published to host (default 5000)
APP_PORT=5000

# ── CORS / Client URL ──────────────────────────────────────────────────────
# CLIENT_URL — the origin browsers use to access the app
# Set to http://localhost:5000 for single-machine, or http://SERVER-LAN-IP:5000
CLIENT_URL=http://localhost:5000

# CORS_ORIGINS — optional comma-separated allowlist
# Leave empty to allow all origins (safe for LAN parish networks)
# Example: "http://localhost:5000,http://192.168.1.100:5000,http://ecclesia.local:5000"
CORS_ORIGINS=

# ── First Admin Account ────────────────────────────────────────────────────
# Created on first seed. If SUPER_ADMIN_PASSWORD is empty, a random password
# is generated and printed to docker compose logs app — check logs after
# first startup to get the password.
SUPER_ADMIN_EMAIL=maxblessngugi@ecclesia.local
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Max Bless Ngugi

# ── Backups ─────────────────────────────────────────────────────────────────
# Backups are DISABLED by default inside Docker (pg_dump runs in a container
# without direct host access). To enable:
#   1. Set BACKUP_DISABLED=false
#   2. Mount a host directory for backups (already configured in compose)
#   3. Or use host-level pg_dump against the running container:
#      docker compose exec db pg_dump -U ecclesia ecclesia > backup.sql
BACKUP_DIR=./backups
